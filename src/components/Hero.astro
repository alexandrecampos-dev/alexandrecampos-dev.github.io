---
---

<section id="inicio" class="relative min-h-screen flex items-center overflow-hidden bg-grid">

  <div class="blob-1" style="top:-150px;left:-200px;"></div>
  <div class="blob-2" style="top:80px;right:-150px;"></div>
  <div style="position:absolute;bottom:0;left:0;right:0;height:200px;background:linear-gradient(to bottom,transparent,#0a0a0f);pointer-events:none;"></div>

  <div class="hero-layout">

    <!-- Left -->
    <div>
      <div class="animate-fade-in animate-delay-1" style="display:inline-flex;align-items:center;gap:.5rem;background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.28);border-radius:9999px;padding:.3rem .9rem;margin-bottom:1.75rem;">
        <span style="width:7px;height:7px;border-radius:9999px;background:#4ade80;box-shadow:0 0 10px #4ade8099;"></span>
        <span style="font-size:.74rem;color:#a5b4fc;font-weight:500;letter-spacing:.04em;font-family:'JetBrains Mono',monospace;">// disponível para projetos</span>
      </div>

      <h1 class="animate-fade-in animate-delay-2 text-gradient hero-name">
        Alexandre<br/>Campos
      </h1>

      <div class="animate-fade-in animate-delay-3 hero-typed-row">
        <span id="hero-typed" style="color:#9090c0;"></span><span class="cursor-blink"></span>
      </div>

      <!-- Stats -->
      <div class="animate-fade-in animate-delay-3 hero-stats">
        {[
          { value: "10+", label: "anos de experiência" },
          { value: ".NET", label: "stack principal" },
          { value: "MCP · RAG", label: "foco atual" },
        ].map(s => (
          <div>
            <div style="font-size:1.2rem;font-weight:800;color:#a5b4fc;letter-spacing:-.02em;line-height:1;">{s.value}</div>
            <div style="font-size:.67rem;color:#4a4a68;font-weight:600;text-transform:uppercase;letter-spacing:.1em;margin-top:4px;font-family:'JetBrains Mono',monospace;">{s.label}</div>
          </div>
        ))}
        <div class="stats-divider"></div>
        <div style="display:flex;align-items:center;gap:.45rem;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
          <span style="font-size:.77rem;color:#4a4a68;font-weight:500;">Campo Grande, Brasil</span>
        </div>
      </div>

      <!-- CTAs -->
      <div class="animate-fade-in animate-delay-4 hero-ctas">
        <a href="#projetos" class="btn-primary">Ver projetos</a>
        <a href="https://www.linkedin.com/in/alexandre-campos-3725b18b/" target="_blank" rel="noopener" class="btn-ghost">LinkedIn</a>
        <a href="https://github.com/alexandrecampos-dev" target="_blank" rel="noopener" class="btn-ghost">GitHub</a>
      </div>
    </div>

    <!-- Right: spinning ring -->
    <div class="animate-fade-in animate-delay-2 hero-photo-wrap">
      <div style="position:absolute;inset:-40px;background:radial-gradient(circle,rgba(99,102,241,0.22) 0%,rgba(6,182,212,0.08) 50%,transparent 70%);filter:blur(30px);border-radius:9999px;pointer-events:none;"></div>
      <div class="avatar-ring">
        <img src="/photo-hero.jpg" alt="Alexandre Campos" />
      </div>
      <div class="open-to-work-badge">
        <div style="width:6px;height:6px;border-radius:9999px;background:#4ade80;box-shadow:0 0 8px #4ade80;"></div>
        <span style="font-size:.72rem;color:#a5b4fc;font-weight:600;letter-spacing:.04em;font-family:'JetBrains Mono',monospace;">Open to work</span>
      </div>
    </div>

  </div>
</section>

<style>
  .hero-layout {
    position: relative;
    z-index: 10;
    max-width: 72rem;
    margin: 0 auto;
    padding: 6rem 2rem 4rem;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 5rem;
    align-items: center;
    width: 100%;
  }

  .hero-name {
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.06;
    margin-bottom: 1rem;
    letter-spacing: -.03em;
  }

  .hero-typed-row {
    font-size: 1.05rem;
    color: #6b6b95;
    font-weight: 500;
    margin-bottom: 1.75rem;
    min-height: 1.8rem;
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .stats-divider {
    width: 1px;
    height: 2rem;
    background: rgba(255,255,255,0.07);
    align-self: center;
  }

  .hero-ctas {
    display: flex;
    gap: .75rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    color: #fff;
    padding: .65rem 1.6rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: .88rem;
    text-decoration: none;
    box-shadow: 0 0 32px rgba(99,102,241,0.4);
    letter-spacing: .01em;
    transition: transform .2s, box-shadow .2s;
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 44px rgba(99,102,241,0.55);
  }

  .btn-ghost {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.1);
    color: #7878a8;
    padding: .65rem 1.6rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: .88rem;
    text-decoration: none;
    transition: all .2s;
  }
  .btn-ghost:hover {
    border-color: rgba(99,102,241,0.5);
    color: #e2e8f0;
    background: rgba(99,102,241,0.08);
    transform: translateY(-2px);
  }

  .hero-photo-wrap {
    flex-shrink: 0;
    position: relative;
  }

  .open-to-work-badge {
    position: absolute;
    bottom: -18px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(8,8,14,0.92);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 9999px;
    padding: .4rem 1.1rem;
    display: flex;
    align-items: center;
    gap: .5rem;
    white-space: nowrap;
    box-shadow: 0 4px 24px rgba(0,0,0,0.6);
    backdrop-filter: blur(12px);
  }

  /* ── Responsivo ── */
  @media (max-width: 860px) {
    .hero-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 5rem;
      text-align: center;
    }

    .hero-stats {
      justify-content: center;
    }

    .hero-ctas {
      justify-content: center;
    }

    .hero-typed-row {
      justify-content: center;
    }

    .hero-photo-wrap {
      display: flex;
      justify-content: center;
      order: -1; /* foto acima do texto no mobile */
      margin-bottom: 1rem;
    }

    .avatar-ring {
      width: 220px !important;
      height: 220px !important;
    }
  }

  @media (max-width: 480px) {
    .hero-layout {
      padding: 5rem 1.25rem 3rem;
    }

    .hero-stats {
      gap: 1.25rem;
    }

    .stats-divider {
      display: none;
    }

    .avatar-ring {
      width: 180px !important;
      height: 180px !important;
    }
  }
</style>

<script>
  const roles = [
    'Engenheiro de Software',
    'Engenheiro de IA',
    'Arquiteto .NET',
    'Builder de Agentes MCP',
    'RAG Pipeline Developer',
  ];
  const el = document.getElementById('hero-typed');
  if (el) {
    let ri = 0, ci = 0, deleting = false;
    function tick() {
      const word = roles[ri];
      el.textContent = deleting ? word.slice(0, ci--) : word.slice(0, ci++);
      let delay = deleting ? 45 : 80;
      if (!deleting && ci > word.length)  { delay = 1800; deleting = true; }
      else if (deleting && ci < 0)        { deleting = false; ci = 0; ri = (ri + 1) % roles.length; delay = 400; }
      setTimeout(tick, delay);
    }
    setTimeout(tick, 700);
  }
</script>
