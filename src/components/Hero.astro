---
---

<section id="inicio" class="relative min-h-screen flex items-center overflow-hidden bg-grid">

  <!-- Gradient blobs -->
  <div class="blob-1" style="top: -100px; left: -150px;"></div>
  <div class="blob-2" style="top: 200px; right: 0px;"></div>

  <!-- Fade overlay at bottom -->
  <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 180px; background: linear-gradient(to bottom, transparent, #080810); pointer-events: none;"></div>

  <div style="position: relative; z-index: 10; max-width: 72rem; margin: 0 auto; padding: 0 2rem; display: grid; grid-template-columns: 1fr auto; gap: 5rem; align-items: center; width: 100%; padding-top: 5rem; padding-bottom: 4rem;">

    <!-- Left: text -->
    <div>
      <div class="animate-fade-in animate-delay-1" style="display: inline-flex; align-items: center; gap: 0.5rem; background: #1a1a2e; border: 1px solid #2a2a42; border-radius: 9999px; padding: 0.3rem 0.9rem; margin-bottom: 1.5rem;">
        <span style="width: 8px; height: 8px; border-radius: 9999px; background: #4ade80; box-shadow: 0 0 8px #4ade80;"></span>
        <span style="font-size: 0.78rem; color: #a5b4fc; font-weight: 500;">Disponível para projetos</span>
      </div>

      <h1 class="animate-fade-in animate-delay-2 text-gradient" style="font-size: clamp(2.8rem, 5vw, 4.2rem); font-weight: 800; line-height: 1.05; margin-bottom: 1rem; letter-spacing: -0.02em;">
        Alexandre<br/>Campos
      </h1>

      <h2 class="animate-fade-in animate-delay-3" style="font-size: 1.15rem; color: #6b6b8a; font-weight: 500; margin-bottom: 1.5rem; letter-spacing: -0.01em;">
        Engenheiro de Software <span style="color: #2d2d45; margin: 0 0.4rem;">·</span> Engenheiro de IA
      </h2>

      <p class="animate-fade-in animate-delay-3" style="color: #7070a0; line-height: 1.85; font-size: 0.98rem; margin-bottom: 2.5rem; max-width: 480px;">
        Mais de 10 anos em sistemas escaláveis com <strong style="color: #c4c4e0;">.NET</strong> e <strong style="color: #c4c4e0;">Angular</strong>.
        Foco atual em <strong style="color: #a5b4fc;">servidores MCP</strong>, pipelines
        <strong style="color: #a5b4fc;">RAG</strong> e integração de LLMs com
        <strong style="color: #c4c4e0;">Azure AI, Groq e Ollama</strong>.
      </p>

      <!-- Stats row -->
      <div class="animate-fade-in animate-delay-3" style="display: flex; gap: 2rem; margin-bottom: 2.5rem; flex-wrap: wrap;">
        {[
          { value: "10+", label: "anos" },
          { value: ".NET", label: "stack" },
          { value: "MCP", label: "& RAG" },
        ].map(s => (
          <div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #a5b4fc; letter-spacing: -0.02em;">{s.value}</div>
            <div style="font-size: 0.72rem; color: #40405a; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em;">{s.label}</div>
          </div>
        ))}
        <div style="width: 1px; background: #1a1a2e; align-self: stretch;"></div>
        <div style="display: flex; align-items: center; gap: 0.6rem;">
          <div style="width: 8px; height: 8px; border-radius: 9999px; background: #6366f1; box-shadow: 0 0 12px #6366f180;"></div>
          <span style="font-size: 0.8rem; color: #50506e; font-weight: 500;">Campo Grande, Brasil</span>
        </div>
      </div>

      <div class="animate-fade-in animate-delay-4" style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="#projetos" style="background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; padding: 0.6rem 1.5rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem; text-decoration: none; box-shadow: 0 0 24px #6366f140;">
          Ver projetos
        </a>
        <a href="https://www.linkedin.com/in/alexandre-campos-3725b18b/" target="_blank" rel="noopener"
          style="background: #0f0f1a; border: 1px solid #2a2a42; color: #8888b0; padding: 0.6rem 1.5rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: border-color 0.2s, color 0.2s;"
          onmouseover="this.style.borderColor='#6366f1';this.style.color='#e2e2f0'"
          onmouseout="this.style.borderColor='#2a2a42';this.style.color='#8888b0'">
          LinkedIn
        </a>
        <a href="https://github.com/alexandrecampos-dev" target="_blank" rel="noopener"
          style="background: #0f0f1a; border: 1px solid #2a2a42; color: #8888b0; padding: 0.6rem 1.5rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: border-color 0.2s, color 0.2s;"
          onmouseover="this.style.borderColor='#6366f1';this.style.color='#e2e2f0'"
          onmouseout="this.style.borderColor='#2a2a42';this.style.color='#8888b0'">
          GitHub
        </a>
      </div>
    </div>

    <!-- Right: photo -->
    <div class="animate-fade-in animate-delay-2" style="flex-shrink: 0; position: relative;">

      <!-- Outer glow ring -->
      <div style="position: absolute; inset: -3px; border-radius: 22px; background: linear-gradient(135deg, #6366f1, #8b5cf6, #6366f1); opacity: 0.6; filter: blur(1px);"></div>

      <!-- Photo -->
      <div style="position: relative; width: 320px; height: 320px; border-radius: 20px; overflow: hidden; border: 1px solid #2a2a42;">
        <img
          src="/photo-hero.jpg"
          alt="Alexandre Campos"
          style="width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block;"
        />
        <!-- Subtle overlay to blend with dark theme -->
        <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 60%, #080810cc); pointer-events: none;"></div>
      </div>

      <!-- Floating badge -->
      <div style="position: absolute; bottom: -14px; left: 50%; transform: translateX(-50%); background: #0f0f1a; border: 1px solid #2a2a42; border-radius: 9999px; padding: 0.4rem 1.1rem; display: flex; align-items: center; gap: 0.5rem; white-space: nowrap; box-shadow: 0 4px 24px #00000060;">
        <div style="width: 7px; height: 7px; border-radius: 9999px; background: #4ade80; box-shadow: 0 0 6px #4ade80;"></div>
        <span style="font-size: 0.75rem; color: #a5b4fc; font-weight: 600;">Open to work</span>
      </div>
    </div>

  </div>
</section>
