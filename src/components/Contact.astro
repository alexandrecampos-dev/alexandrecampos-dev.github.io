      <a href="https://github.com/alexandrecampos-dev" target="_blank" rel="noopener"
        style="background: #0f0f1a; border: 1px solid #2a2a42; color: #8888b0; padding: 0.65rem 1.75rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: border-color 0.2s, color 0.2s;"
        onmouseover="this.style.borderColor='#6366f1';this.style.color='#e2e2f0'"
