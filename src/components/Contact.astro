<section id="contato" style="padding: 7rem 2rem; max-width: 72rem; margin: 0 auto; border-top: 1px solid rgba(255,255,255,0.04);">
  <div style="max-width: 540px; margin: 0 auto; text-align: center;">

    <p class="section-label">Contato</p>
    <h2 style="font-size: 2.2rem; font-weight: 800; color: #e2e8f0; margin-bottom: 1rem; letter-spacing: -0.03em;">
      Vamos conversar
    </h2>
    <p style="color: #40405a; font-size: 0.9rem; line-height: 1.85; margin-bottom: 2.5rem; max-width: 400px; margin-left: auto; margin-right: auto;">
      Aberto a projetos, colaborações ou troca de experiências sobre engenharia de IA e arquitetura .NET.
    </p>

    <div style="display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap;">
      <a href="mailto:alexandre1000a@gmail.com"
        style="background: linear-gradient(135deg, #6366f1, #06b6d4); color: #fff; padding: 0.65rem 1.75rem; border-radius: 8px; font-weight: 600; font-size: 0.88rem; text-decoration: none; box-shadow: 0 0 28px rgba(99,102,241,0.3); letter-spacing: 0.01em;">
        Enviar e-mail
      </a>
      <a href="https://www.linkedin.com/in/alexandre-campos-3725b18b/" target="_blank" rel="noopener"
        style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); color: #6b6b8a; padding: 0.65rem 1.75rem; border-radius: 8px; font-weight: 600; font-size: 0.88rem; text-decoration: none; transition: border-color 0.2s, color 0.2s;"
        onmouseover="this.style.borderColor='rgba(99,102,241,0.5)';this.style.color='#e2e8f0'"
        onmouseout="this.style.borderColor='rgba(255,255,255,0.1)';this.style.color='#6b6b8a'">
        LinkedIn
      </a>
      <a href="https://github.com/alexandrecampos-dev" target="_blank" rel="noopener"
        style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); color: #6b6b8a; padding: 0.65rem 1.75rem; border-radius: 8px; font-weight: 600; font-size: 0.88rem; text-decoration: none; transition: border-color 0.2s, color 0.2s;"
        onmouseover="this.style.borderColor='rgba(99,102,241,0.5)';this.style.color='#e2e8f0'"
        onmouseout="this.style.borderColor='rgba(255,255,255,0.1)';this.style.color='#6b6b8a'">
        GitHub
      </a>
    </div>
  </div>
</section>

<footer style="padding: 2rem; text-align: center; border-top: 1px solid rgba(255,255,255,0.04);">
  <p style="color: #1e1e2e; font-size: 0.78rem; font-weight: 500;">
    Alexandre Campos &copy; {new Date().getFullYear()} &nbsp;·&nbsp; Campo Grande, Brasil
  </p>
</footer>
