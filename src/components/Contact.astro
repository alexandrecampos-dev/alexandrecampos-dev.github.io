<section id="contato" style="padding: 7rem 2rem; max-width: 72rem; margin: 0 auto; border-top: 1px solid #12121f;">
  <div style="max-width: 560px; margin: 0 auto; text-align: center;">

    <p class="section-label">Contato</p>
    <h2 style="font-size: 2.2rem; font-weight: 800; color: #e2e2f0; margin-bottom: 1rem; letter-spacing: -0.02em;">
      Vamos conversar
    </h2>
