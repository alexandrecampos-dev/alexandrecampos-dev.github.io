---
interface Props {
  /** Parágrafo de apresentação, ajustado ao público da página. */
  texto: string;
}

const { texto } = Astro.props;
---

<section class="lp-section">
  <div class="lp-wrap lp-about fade-up">
    <img src="/photo-about.jpg" alt="Alexandre Campos" class="lp-photo" loading="lazy" />
    <div>
      <p class="section-label">Quem faz</p>
      <h2 class="lp-h2">Alexandre Campos</h2>
      <p class="lp-about-role">Engenheiro de Software & IA · Campo Grande/MS</p>
      <p class="lp-about-p">{texto}</p>
      <a href="/" class="lp-card-link">Ver portfólio completo →</a>
    </div>
  </div>
</section>
