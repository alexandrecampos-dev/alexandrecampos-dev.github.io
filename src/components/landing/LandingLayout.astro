---
import Layout from "../../layouts/Layout.astro";
import { EMAIL, whatsappUrl } from "../../data/contact";
import "../../styles/landing.css";

interface Props {
  title: string;
  description: string;
  /** Mensagem pré-preenchida do WhatsApp nesta página (o anúncio e a página falam a mesma língua). */
  ctaMensagem: string;
}

const { title, description, ctaMensagem } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const links = [
  { href: "/ia-para-empresas/", label: "Empresas" },
  { href: "/clinicas/", label: "Clínicas" },
  { href: "/engenharia-de-ia/", label: "Times de tecnologia" },
];
const atual = Astro.url.pathname;
---

<Layout title={title} description={description} canonical={canonical}>
  <header class="lp-nav">
    <div class="lp-nav-inner">
      <a href="/" class="lp-logo">&lt;<span class="logo-name">ac</span> <span class="logo-slash">/</span>&gt;</a>
      <nav class="lp-nav-links" aria-label="Soluções">
        {links.map(l => (
          <a href={l.href} class:list={["lp-nav-link", { ativo: atual === l.href }]} aria-current={atual === l.href ? "page" : undefined}>{l.label}</a>
        ))}
      </nav>
      <a href={whatsappUrl(ctaMensagem)} target="_blank" rel="noopener" class="lp-nav-cta">
        <i class="fa-brands fa-whatsapp"></i><span>Falar no WhatsApp</span>
      </a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="lp-footer">
    Alexandre Campos &copy; {new Date().getFullYear()} · Campo Grande/MS · <a href={`mailto:${EMAIL}`}>{EMAIL}</a> · <a href="/">portfólio</a>
  </footer>

  <a href={whatsappUrl(ctaMensagem)} target="_blank" rel="noopener" class="lp-float" aria-label="Falar no WhatsApp">
    <i class="fa-brands fa-whatsapp"></i>
  </a>
</Layout>
