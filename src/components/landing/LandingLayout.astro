---
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../SiteNav.astro";
import SiteFooter from "../SiteFooter.astro";
import { whatsappUrl } from "../../data/contact";
import { solucoes } from "../../data/solucoes";
import "../../styles/landing.css";

interface Props {
  title: string;
  description: string;
  /** Mensagem pré-preenchida do WhatsApp nesta página (o anúncio e a página falam a mesma língua). */
  ctaMensagem: string;
}

const { title, description, ctaMensagem } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const outras = solucoes.filter(s => s.href !== Astro.url.pathname);
---

<Layout title={title} description={description} canonical={canonical}>
  <SiteNav ctaMensagem={ctaMensagem} />

  <main style="padding-top: 3.5rem;">
    <slot />

    <section class="lp-section">
      <div class="lp-wrap">
        <p class="section-label">Outras soluções</p>
        <div class="lp-portas">
          {outras.map(s => (
            <a href={s.href} class="card-gradient-border lp-porta">
              <span class="lp-plano-tag"><i class={s.icon}></i> {s.para}</span>
              <h3>{s.titulo}</h3>
              <p>{s.desc}</p>
            </a>
          ))}
        </div>
        <p class="lp-sub-sm" style="margin:1.5rem 0 0;"><a href="/#solucoes" class="lp-card-link">← Todas as soluções</a></p>
      </div>
    </section>
  </main>

  <SiteFooter />

  <a href={whatsappUrl(ctaMensagem)} target="_blank" rel="noopener" class="lp-float" aria-label="Falar no WhatsApp">
    <i class="fa-brands fa-whatsapp"></i>
  </a>
</Layout>
