---
const categories = [
  {
    label: "Linguagens & Frameworks",
    color: "#6366f1",
    items: ["C#", ".NET 9", "ASP.NET Core", "TypeScript", "Angular", "Python", "FastAPI"],
  },
  {
    label: "IA & Agentes",
    color: "#8b5cf6",
    items: ["Claude / MCP", "Azure AI Foundry", "Groq", "OpenAI Codex", "Ollama", "RAG / pgvector"],
  },
  {
    label: "Arquitetura",
    color: "#a78bfa",
    items: ["Clean Architecture", "DDD", "CQRS", "MediatR", "TDD", "Hexagonal"],
  },
  {
    label: "Cloud & DevOps",
    color: "#6366f1",
    items: ["Azure", "Docker", "Azure Pipelines", "AWS", "Hangfire", "OpenTelemetry"],
  },
  {
    label: "Banco de dados & Mensageria",
    color: "#8b5cf6",
    items: ["PostgreSQL", "SQL Server", "Oracle", "RabbitMQ", "Service Bus", "EF Core"],
  },
  {
    label: "Segurança",
    color: "#a78bfa",
    items: ["JWT", "Keycloak", "OAuth2", "ASP.NET Identity"],
  },
];
---

<section id="stack" style="padding: 7rem 2rem; max-width: 72rem; margin: 0 auto; border-top: 1px solid #12121f;">

  <div style="margin-bottom: 3.5rem;">
    <p class="section-label">Tecnologias</p>
    <h2 style="font-size: 2.2rem; font-weight: 800; color: #e2e2f0; letter-spacing: -0.02em;">
      Stack
    </h2>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
    {categories.map((cat) => (
      <div class="card-gradient-border" style="padding: 1.5rem;">
        <h3 style={`font-size: 0.72rem; color: ${cat.color}; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem;`}>
          {cat.label}
        </h3>
        <div style="display: flex; flex-wrap: wrap; gap: 0.45rem;">
          {cat.items.map((item) => (
            <span class="tag-pill">{item}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
