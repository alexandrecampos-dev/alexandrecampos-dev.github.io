---
const categories = [
  {
    label: "Linguagens & Frameworks",
    color: "#818cf8",
    items: [
      { name: "C#",           icon: "fa-brands fa-microsoft" },
      { name: ".NET 9",       icon: "fa-brands fa-microsoft" },
      { name: "ASP.NET Core", icon: "fa-solid fa-server" },
      { name: "ABP Framework",icon: "fa-solid fa-boxes-stacked" },
      { name: "TypeScript",   icon: "fa-brands fa-js" },
      { name: "Angular",      icon: "fa-brands fa-angular" },
      { name: "SignalR",      icon: "fa-solid fa-tower-broadcast" },
      { name: "Python",       icon: "fa-brands fa-python" },
      { name: "FastAPI",      icon: "fa-solid fa-bolt" },
    ],
  },
  {
    label: "IA & Agentes",
    color: "#67e8f9",
    items: [
      { name: "Claude MCP",    icon: "fa-solid fa-robot" },
      { name: "Azure AI",      icon: "fa-brands fa-microsoft" },
      { name: "Azure Speech",  icon: "fa-solid fa-microphone-lines" },
      { name: "Groq",          icon: "fa-solid fa-microchip" },
      { name: "OpenAI",        icon: "fa-solid fa-brain" },
      { name: "Ollama",        icon: "fa-solid fa-cube" },
      { name: "RAG/pgvector",  icon: "fa-solid fa-database" },
    ],
  },
  {
    label: "Arquitetura",
    color: "#c084fc",
    items: [
      { name: "Clean Arch",    icon: "fa-solid fa-layer-group" },
      { name: "DDD",           icon: "fa-solid fa-sitemap" },
      { name: "CQRS",          icon: "fa-solid fa-arrows-split-up-and-left" },
      { name: "MediatR",       icon: "fa-solid fa-code-branch" },
      { name: "OpenAPI",       icon: "fa-solid fa-file-code" },
      { name: "TDD",           icon: "fa-solid fa-vial-circle-check" },
      { name: "Hexagonal",     icon: "fa-solid fa-hexagon-nodes" },
    ],
  },
  {
    label: "Cloud & DevOps",
    color: "#818cf8",
    items: [
      { name: "Azure",              icon: "fa-brands fa-microsoft" },
      { name: "Azure Container Apps",icon: "fa-solid fa-boxes-stacked" },
      { name: "Azure DevOps",       icon: "fa-brands fa-microsoft" },
      { name: "Docker",             icon: "fa-brands fa-docker" },
      { name: "AWS",                icon: "fa-brands fa-aws" },
      { name: "Hangfire",           icon: "fa-solid fa-clock-rotate-left" },
      { name: "OpenTelemetry",      icon: "fa-solid fa-chart-line" },
    ],
  },
  {
    label: "Banco de dados & Mensageria",
    color: "#67e8f9",
    items: [
      { name: "PostgreSQL",  icon: "fa-solid fa-database" },
      { name: "SQL Server",  icon: "fa-solid fa-table" },
      { name: "Oracle",      icon: "fa-solid fa-database" },
      { name: "EF Core",     icon: "fa-solid fa-link" },
      { name: "Dapper",      icon: "fa-solid fa-plug" },
      { name: "RabbitMQ",    icon: "fa-solid fa-envelope-open-text" },
      { name: "Service Bus", icon: "fa-brands fa-microsoft" },
    ],
  },
  {
    label: "Segurança",
    color: "#c084fc",
    items: [
      { name: "JWT",              icon: "fa-solid fa-key" },
      { name: "Keycloak",         icon: "fa-solid fa-shield-halved" },
      { name: "OAuth2",           icon: "fa-solid fa-lock" },
      { name: "ASP.NET Identity", icon: "fa-solid fa-user-shield" },
    ],
  },
];
---

<section id="stack" style="padding:7rem 2rem;max-width:72rem;margin:0 auto;border-top:1px solid rgba(255,255,255,0.06);">

  <div class="fade-up">
    <p class="section-label">Tecnologias</p>
    <h2 style="font-size:2.2rem;font-weight:800;color:#e2e8f0;letter-spacing:-.03em;">Stack</h2>
    <div class="section-line"></div>
  </div>

  <div style="display:flex;flex-direction:column;gap:2.5rem;">
    {categories.map((cat, ci) => (
      <div class="fade-up" style={`transition-delay:${ci * 0.07}s`}>
        <p class="stack-cat-label" style={`color:${cat.color};`}>{cat.label}</p>
        <div class="stack-grid">
          {cat.items.map((item) => (
            <div class="stack-item"
              data-color={cat.color}
              onmouseover={`this.style.borderColor='${cat.color}45';this.style.background='${cat.color}0e';this.style.transform='translateY(-3px)';this.querySelector('i').style.color='${cat.color}';`}
              onmouseout={`this.style.borderColor='rgba(255,255,255,0.08)';this.style.background='rgba(255,255,255,0.03)';this.style.transform='';this.querySelector('i').style.color='${cat.color}bb';`}>
              <i class={item.icon} style={`font-size:1.3rem;color:${cat.color}bb;transition:color .2s;`}></i>
              <span>{item.name}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .stack-cat-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: .68rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: .75rem;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
    gap: .55rem;
  }

  .stack-item {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: .8rem .4rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .35rem;
    cursor: default;
    transition: all .2s;
  }

  .stack-item span {
    font-size: .68rem;
    font-weight: 500;
    color: #7878a8;
    line-height: 1.3;
  }

  @media (max-width: 640px) {
    .stack-grid {
      grid-template-columns: repeat(auto-fill, minmax(76px, 1fr));
    }
  }
</style>
