---
import { experiences } from "../data/experience";
---

<section id="experiencia" style="padding:7rem 2rem;max-width:72rem;margin:0 auto;border-top:1px solid rgba(255,255,255,0.06);">

  <div class="fade-up">
    <p class="section-label">Trajetória</p>
    <h2 style="font-size:2.2rem;font-weight:800;color:#e2e8f0;letter-spacing:-.03em;">Experiência</h2>
    <div class="section-line"></div>
  </div>

  <div style="display:flex;flex-direction:column;gap:0;">
    {experiences.map((exp, i) => (
      <div class="fade-up" style={`display:grid;grid-template-columns:150px 1fr;gap:2rem;position:relative;padding-bottom:2rem;transition-delay:${i * 0.08}s`}>

        <div style="text-align:right;padding-top:.3rem;">
          <span style="font-size:.74rem;color:#4a4a68;font-weight:500;font-family:'JetBrains Mono',monospace;">{exp.period}</span>
        </div>

        <div style="position:relative;padding-left:2rem;">
          <div style="position:absolute;left:0;top:0;display:flex;flex-direction:column;align-items:center;height:100%;">
            <div class={i === 0 ? "timeline-dot-active" : ""}
              style={`width:9px;height:9px;border-radius:9999px;background:${i === 0 ? '#6366f1' : '#2a2a42'};border:2px solid ${i === 0 ? '#818cf8' : '#383858'};flex-shrink:0;z-index:1;margin-top:3px;`}>
            </div>
            {i < experiences.length - 1 && (
              <div style="width:1px;flex:1;background:linear-gradient(to bottom,rgba(99,102,241,0.22),rgba(99,102,241,0.03));margin-top:6px;"></div>
            )}
          </div>

          <div class="card-gradient-border" style="padding:1.25rem 1.4rem;">
            <div style="display:flex;flex-wrap:wrap;align-items:baseline;gap:.5rem;margin-bottom:.65rem;">
              <h3 style="font-size:.95rem;font-weight:700;color:#e2e8f0;">{exp.role}</h3>
              <span style="font-size:.8rem;color:#818cf8;font-weight:600;">{exp.company}</span>
            </div>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.4rem;">
              {exp.description.map((item) => (
                <li style="color:#7070a0;font-size:.83rem;line-height:1.65;display:flex;gap:.5rem;">
                  <span style="color:#383858;flex-shrink:0;font-size:.65rem;margin-top:.32rem;">▸</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
