---
import { experiences } from "../data/experience";
---

<section id="experiencia" style="padding: 6rem 1.5rem; max-width: 64rem; margin: 0 auto; border-top: 1px solid #27272a;">
  <p style="color: #a5b4fc; font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.5rem;">
    Trajetória
  </p>
  <h2 style="font-size: 2rem; font-weight: 700; color: #f4f4f5; margin-bottom: 3rem;">
    Experiência
  </h2>

  <div style="position: relative; padding-left: 1.5rem; border-left: 2px solid #27272a; display: flex; flex-direction: column; gap: 3rem;">
    {experiences.map((exp) => (
      <div style="position: relative;">
        <div style="position: absolute; left: -1.85rem; top: 0.35rem; width: 0.75rem; height: 0.75rem; border-radius: 9999px; background-color: #6366f1;"></div>

        <div style="display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.75rem; margin-bottom: 0.5rem;">
          <h3 style="font-size: 1.05rem; font-weight: 700; color: #f4f4f5;">
            {exp.role}
          </h3>
          <span style="font-size: 0.85rem; color: #6366f1; font-weight: 600;">
            {exp.company}
          </span>
          <span style="font-size: 0.8rem; color: #52525b; margin-left: auto;">
            {exp.period}
          </span>
        </div>

        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem;">
          {exp.description.map((item) => (
            <li style="color: #a1a1aa; font-size: 0.9rem; line-height: 1.7; display: flex; gap: 0.5rem;">
              <span style="color: #4f46e5; flex-shrink: 0; margin-top: 0.1rem;">—</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
