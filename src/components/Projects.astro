---
import { projects } from "../data/projects";
import Terminal from "./Terminal.astro";
---

<section id="projetos" style="padding:7rem 2rem;max-width:72rem;margin:0 auto;">

  <div class="fade-up">
    <p class="section-label">Portfólio</p>
    <h2 style="font-size:2.2rem;font-weight:800;color:#e2e8f0;margin-bottom:.5rem;letter-spacing:-.03em;">Projetos</h2>
    <div class="section-line"></div>
  </div>

  <div class="fade-up delay-1" style="margin-bottom:2.5rem;">
    <Terminal />
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.25rem;">
    {projects.map((project, i) => (
      <a href={project.url} target="_blank" rel="noopener" class="card-gradient-border fade-up"
        style={`padding:1.75rem;text-decoration:none;display:flex;flex-direction:column;gap:1rem;transition-delay:${i * 0.1}s`}>

        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:.5rem;">
          <div style="width:38px;height:38px;border-radius:9px;background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.22);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="fa-solid fa-code" style="font-size:.9rem;color:#818cf8;"></i>
          </div>
          {project.highlight && (
            <span style="font-size:.65rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.3);color:#a5b4fc;padding:.2rem .65rem;border-radius:9999px;font-family:'JetBrains Mono',monospace;">
              Destaque
            </span>
          )}
        </div>

        <div>
          <h3 style="font-size:.95rem;font-weight:700;color:#e2e8f0;margin-bottom:.5rem;font-family:'JetBrains Mono',monospace;">
            {project.name}
          </h3>
          <p style="font-size:.85rem;line-height:1.75;color:#7070a0;">{project.description}</p>
        </div>

        <div style="margin-top:auto;display:flex;flex-wrap:wrap;gap:.4rem;">
          {project.tags.slice(0, 5).map((tag) => (
            <span class="tag-pill">{tag}</span>
          ))}
        </div>

        <div style="display:flex;align-items:center;gap:.4rem;color:#818cf8;font-size:.8rem;font-weight:600;margin-top:.25rem;font-family:'JetBrains Mono',monospace;">
          <i class="fa-brands fa-github" style="font-size:.85rem;"></i>
          <span>Ver repositório</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
      </a>
    ))}
  </div>
</section>
