---
import { projects } from "../data/projects";
import Terminal from "./Terminal.astro";
---

<section id="projetos" style="padding: 7rem 2rem; max-width: 72rem; margin: 0 auto;">

  <div style="margin-bottom: 3.5rem;">
    <p class="section-label">Portfólio</p>
    <h2 style="font-size: 2.2rem; font-weight: 800; color: #e2e8f0; margin-bottom: 0.75rem; letter-spacing: -0.03em;">
      Projetos
    </h2>
    <p style="color: #40405a; font-size: 0.9rem; max-width: 420px; line-height: 1.7;">
      Projetos públicos com foco em engenharia de IA e arquitetura .NET.
    </p>
  </div>

  <!-- Terminal highlight -->
  <div style="margin-bottom: 2.5rem;">
    <Terminal />
  </div>

  <!-- Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem;">
    {projects.map((project) => (
      <a href={project.url} target="_blank" rel="noopener" class="card-gradient-border" style="padding: 1.75rem; text-decoration: none; display: flex; flex-direction: column; gap: 1rem;">

        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem;">
          <div style="width: 38px; height: 38px; border-radius: 9px; background: rgba(99,102,241,0.08); border: 1px solid rgba(99,102,241,0.2); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#818cf8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          {project.highlight && (
            <span style="font-size: 0.66rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.3); color: #a5b4fc; padding: 0.2rem 0.65rem; border-radius: 9999px;">
              Destaque
            </span>
          )}
        </div>

        <div>
          <h3 style="font-size: 0.95rem; font-weight: 700; color: #e2e8f0; margin-bottom: 0.5rem; font-family: ui-monospace, 'Cascadia Code', monospace; letter-spacing: -0.01em;">
            {project.name}
          </h3>
          <p style="font-size: 0.85rem; line-height: 1.75; color: #50506e;">
            {project.description}
          </p>
        </div>

        <div style="margin-top: auto; display: flex; flex-wrap: wrap; gap: 0.4rem;">
          {project.tags.slice(0, 5).map((tag) => (
            <span class="tag-pill">{tag}</span>
          ))}
        </div>

        <div style="display: flex; align-items: center; gap: 0.4rem; color: #6366f1; font-size: 0.8rem; font-weight: 600; margin-top: 0.25rem;">
          <span>Ver repositório</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>
