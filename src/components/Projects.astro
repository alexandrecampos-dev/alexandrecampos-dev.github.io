---
import { projects } from "../data/projects";
---

<section id="projetos" style="padding: 7rem 2rem; max-width: 72rem; margin: 0 auto;">

  <div style="margin-bottom: 3.5rem;">
    <p class="section-label">Portfólio</p>
    <h2 style="font-size: 2.2rem; font-weight: 800; color: #e2e2f0; margin-bottom: 0.75rem; letter-spacing: -0.02em;">
      Projetos
    </h2>
    <p style="color: #50506e; font-size: 0.95rem; max-width: 440px; line-height: 1.7;">
      Projetos públicos com foco em engenharia de IA e arquitetura .NET.
    </p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem;">
    {projects.map((project) => (
      <a href={project.url} target="_blank" rel="noopener" class="card-gradient-border" style="padding: 1.75rem; text-decoration: none; display: flex; flex-direction: column; gap: 1rem;">

        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem;">
          <div style="width: 40px; height: 40px; border-radius: 10px; background: linear-gradient(135deg, #6366f115, #8b5cf615); border: 1px solid #2a2a42; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          {project.highlight && (
            <span style="font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; background: #1a1a2e; border: 1px solid #3a3a5e; color: #a5b4fc; padding: 0.25rem 0.6rem; border-radius: 9999px;">
              Destaque
            </span>
          )}
        </div>

        <div>
          <h3 style="font-size: 1rem; font-weight: 700; color: #e2e2f0; margin-bottom: 0.6rem; font-family: ui-monospace, 'Cascadia Code', monospace;">
            {project.name}
          </h3>
          <p style="color: #6060808; font-size: 0.875rem; line-height: 1.75; color: #60608a;">
            {project.description}
          </p>
        </div>

        <div style="margin-top: auto; display: flex; flex-wrap: wrap; gap: 0.4rem;">
          {project.tags.slice(0, 5).map((tag) => (
            <span class="tag-pill">{tag}</span>
          ))}
        </div>

        <div style="display: flex; align-items: center; gap: 0.4rem; color: #6366f1; font-size: 0.82rem; font-weight: 600; margin-top: 0.25rem;">
          <span>Ver repositório</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>
