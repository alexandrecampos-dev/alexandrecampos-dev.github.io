---
import { whatsappUrl } from "../data/contact";

const services = [
  {
    icon: "fa-brands fa-whatsapp",
    title: "Assistente de IA no WhatsApp",
    desc: "Atende, agenda, confirma horários e responde dúvidas 24h, e passa para um humano quando precisa.",
    for: "Clínicas, imobiliárias, varejo e serviços",
  },
  {
    icon: "fa-solid fa-file-lines",
    title: "IA sobre os seus documentos",
    desc: "Pergunte em português e receba a resposta com a fonte citada: contratos, normas, laudos e manuais internos.",
    for: "Escritórios jurídicos e contábeis, agro e indústria",
  },
  {
    icon: "fa-solid fa-gears",
    title: "Automação e sistemas sob medida",
    desc: "Integração de IA com o seu ERP, CRM ou planilhas, pós-venda automático e sistemas .NET feitos para o seu processo.",
    for: "Empresas com processos manuais e repetitivos",
  },
  {
    icon: "fa-solid fa-compass",
    title: "Diagnóstico de IA",
    desc: "Em 2 a 4 horas, mapeio onde a IA gera retorno no seu negócio e entrego um plano com prioridades e custos.",
    for: "Quem quer usar IA e não sabe por onde começar",
  },
];
---

<section id="servicos" style="padding:7rem 2rem;max-width:72rem;margin:0 auto;border-top:1px solid rgba(255,255,255,0.06);">

  <div class="fade-up">
    <p class="section-label">Serviços</p>
    <h2 style="font-size:2.2rem;font-weight:800;color:#e2e8f0;letter-spacing:-.03em;">IA aplicada ao seu negócio</h2>
    <div class="section-line"></div>
    <p class="svc-intro">
      Desenvolvimento e consultoria para empresas de Campo Grande e de todo o Brasil, com atendimento presencial ou remoto.
      Projeto com escopo e preço fechados, do diagnóstico à entrega.
    </p>
  </div>

  <div class="svc-grid">
    {services.map((s, i) => (
      <div class="card-gradient-border fade-up svc-card" style={`transition-delay:${i * 0.1}s`}>
        <div class="svc-icon"><i class={s.icon}></i></div>
        <h3 class="svc-title">{s.title}</h3>
        <p class="svc-desc">{s.desc}</p>
        <p class="svc-for"><span>para</span> {s.for}</p>
        <a href={whatsappUrl(`Olá, Alexandre! Tenho interesse em: ${s.title}.`)} target="_blank" rel="noopener" class="svc-link">
          <i class="fa-brands fa-whatsapp"></i> Conversar sobre isso
        </a>
      </div>
    ))}
  </div>

  <div class="fade-up svc-cta">
    <a href={whatsappUrl("Olá, Alexandre! Quero agendar um diagnóstico de IA para a minha empresa.")} target="_blank" rel="noopener" class="svc-btn">
      <i class="fa-brands fa-whatsapp"></i> Agendar um diagnóstico
    </a>
  </div>
</section>

<style>
  .svc-intro {
    color: #8080a8;
    font-size: .97rem;
    line-height: 1.85;
    max-width: 640px;
    margin: -1rem 0 2.5rem;
  }

  .svc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 1100px) {
    .svc-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .svc-grid { grid-template-columns: 1fr; }
  }

  .svc-card {
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }

  .svc-icon {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: rgba(99,102,241,0.1);
    border: 1px solid rgba(99,102,241,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #818cf8;
    font-size: 1rem;
  }

  .svc-title {
    font-size: 1rem;
    font-weight: 700;
    color: #e2e8f0;
  }

  .svc-desc {
    font-size: .85rem;
    line-height: 1.75;
    color: #7070a0;
  }

  .svc-for {
    font-size: .76rem;
    color: #67e8f9;
    line-height: 1.5;
  }
  .svc-for span {
    font-family: 'JetBrains Mono', monospace;
    color: #4a4a68;
    margin-right: .25rem;
  }

  .svc-link {
    margin-top: auto;
    padding-top: .25rem;
    color: #818cf8;
    font-size: .8rem;
    font-weight: 600;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
  }
  .svc-link:hover { color: #c7d2fe; }

  .svc-cta {
    margin-top: 2.5rem;
    text-align: center;
  }

  .svc-btn {
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    color: #fff;
    padding: .7rem 1.8rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: .9rem;
    text-decoration: none;
    box-shadow: 0 0 32px rgba(99,102,241,0.4);
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    transition: transform .2s, box-shadow .2s;
  }
  .svc-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 44px rgba(99,102,241,0.55);
  }

  @media (max-width: 480px) {
    .svc-btn { width: 100%; justify-content: center; }
  }
</style>
