---
import { whatsappUrl } from "../data/contact";

const topics = [
  {
    title: "IA na prática para o seu negócio",
    desc: "Onde a IA já dá retorno hoje (atendimento, documentos e automação) e como começar sem desperdiçar dinheiro.",
    audience: "Empresários, associações comerciais e Sebrae",
  },
  {
    title: "IA segura com os dados da empresa",
    desc: "Como usar IA sobre documentos internos sem vazar informação: RAG com fonte citada, governança e humano no controle.",
    audience: "Gestores, TI, jurídico e contabilidade",
  },
  {
    title: "Do chatbot ao agente: construindo com MCP e RAG",
    desc: "Como funciona por dentro um agente que consulta sistemas reais, com demonstração ao vivo em .NET.",
    audience: "Desenvolvedores, faculdades e comunidades tech",
  },
];

const formats = [
  { icon: "fa-solid fa-microphone", label: "Palestra", detail: "40 a 60 min" },
  { icon: "fa-solid fa-chalkboard-user", label: "Workshop prático", detail: "2 a 4 h" },
  { icon: "fa-solid fa-building", label: "Treinamento in company", detail: "sob medida" },
];
---

<section id="palestras" style="padding:7rem 2rem;max-width:72rem;margin:0 auto;border-top:1px solid rgba(255,255,255,0.06);">

  <div class="fade-up">
    <p class="section-label">Palestras</p>
    <h2 style="font-size:2.2rem;font-weight:800;color:#e2e8f0;letter-spacing:-.03em;">Palestras e workshops</h2>
    <div class="section-line"></div>
    <p class="tk-intro">
      Conteúdo direto, sem hype, baseado em IA rodando em produção. Para eventos, empresas, entidades e instituições de ensino.
    </p>
  </div>

  <div class="tk-grid">
    {topics.map((t, i) => (
      <div class="card-gradient-border fade-up tk-card" style={`transition-delay:${i * 0.1}s`}>
        <span class="tk-num">0{i + 1}</span>
        <h3 class="tk-title">{t.title}</h3>
        <p class="tk-desc">{t.desc}</p>
        <p class="tk-aud"><span>público</span> {t.audience}</p>
      </div>
    ))}
  </div>

  <div class="fade-up tk-bottom">
    <div class="tk-formats">
      {formats.map(f => (
        <div class="tk-format">
          <i class={f.icon}></i>
          <div>
            <strong>{f.label}</strong>
            <span>{f.detail}</span>
          </div>
        </div>
      ))}
    </div>
    <a href={whatsappUrl("Olá, Alexandre! Gostaria de convidar você para uma palestra/workshop.")} target="_blank" rel="noopener" class="tk-btn">
      <i class="fa-brands fa-whatsapp"></i> Convidar para palestrar
    </a>
  </div>
</section>

<style>
  .tk-intro {
    color: #8080a8;
    font-size: .97rem;
    line-height: 1.85;
    max-width: 640px;
    margin: -1rem 0 2.5rem;
  }

  .tk-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .tk-card {
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: .7rem;
  }

  .tk-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: .75rem;
    font-weight: 600;
    color: #67e8f9;
  }

  .tk-title {
    font-size: 1rem;
    font-weight: 700;
    color: #e2e8f0;
    line-height: 1.4;
  }

  .tk-desc {
    font-size: .85rem;
    line-height: 1.75;
    color: #7070a0;
  }

  .tk-aud {
    margin-top: auto;
    font-size: .76rem;
    color: #a5b4fc;
    line-height: 1.5;
  }
  .tk-aud span {
    font-family: 'JetBrains Mono', monospace;
    color: #4a4a68;
    margin-right: .25rem;
  }

  .tk-bottom {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .tk-formats {
    display: flex;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .tk-format {
    display: flex;
    align-items: center;
    gap: .6rem;
    color: #818cf8;
  }
  .tk-format strong {
    display: block;
    font-size: .85rem;
    color: #d0d4f0;
  }
  .tk-format span {
    font-size: .74rem;
    color: #5a5a80;
    font-family: 'JetBrains Mono', monospace;
  }

  .tk-btn {
    background: rgba(99,102,241,0.08);
    border: 1px solid rgba(99,102,241,0.35);
    color: #c7d2fe;
    padding: .65rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: .88rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    transition: all .2s;
  }
  .tk-btn:hover {
    background: rgba(99,102,241,0.16);
    border-color: rgba(99,102,241,0.6);
    transform: translateY(-2px);
  }

  @media (max-width: 480px) {
    .tk-btn { width: 100%; justify-content: center; }
  }
</style>
