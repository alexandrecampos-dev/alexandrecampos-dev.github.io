---
---

<nav style="position: fixed; top: 0; left: 0; right: 0; z-index: 50; backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); background-color: rgba(10, 10, 12, 0.75); border-bottom: 1px solid rgba(255,255,255,0.06);">
  <div style="max-width: 72rem; margin: 0 auto; padding: 0 2rem; height: 3.5rem; display: flex; align-items: center; justify-content: space-between;">

    <a href="#inicio" style="font-weight: 800; color: #e2e8f0; text-decoration: none; font-size: 0.95rem; letter-spacing: -0.02em;">
      ac<span style="color: #6366f1; font-size: 1.1rem;">.</span><span style="color: #67e8f9;">dev</span>
    </a>

    <div style="display: flex; gap: 2rem; align-items: center;">
      {[
        { href: "#projetos", label: "Projetos" },
        { href: "#stack", label: "Stack" },
        { href: "#experiencia", label: "Experiência" },
        { href: "#contato", label: "Contato" },
      ].map(({ href, label }) => (
        <a href={href}
          style="color: #363650; text-decoration: none; font-size: 0.85rem; font-weight: 500; transition: color 0.2s;"
          onmouseover="this.style.color='#e2e8f0'"
          onmouseout="this.style.color='#363650'">
          {label}
        </a>
      ))}

      <a href="https://github.com/alexandrecampos-dev" target="_blank" rel="noopener"
        style="background: rgba(99,102,241,0.08); border: 1px solid rgba(99,102,241,0.25); color: #a5b4fc; padding: 0.35rem 0.9rem; border-radius: 6px; font-size: 0.8rem; font-weight: 600; text-decoration: none; transition: background 0.2s, border-color 0.2s;"
        onmouseover="this.style.background='rgba(99,102,241,0.15)';this.style.borderColor='rgba(99,102,241,0.5)'"
        onmouseout="this.style.background='rgba(99,102,241,0.08)';this.style.borderColor='rgba(99,102,241,0.25)'">
        GitHub
      </a>
    </div>
  </div>
</nav>
